generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A clinic. Every piece of data belongs to a tenant and queries are always
/// filtered by tenantId — that is what guarantees isolation between clinics.
/// Theme preferences live here so each clinic has its own.
model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  themeMode   String   @default("system") // light | dark | system
  accentColor String   @default("#0071e3")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users          User[]
  materials      Material[]
  instruments    Instrument[]
  procedures     Procedure[]
  suppliers      Supplier[]
  stockMovements StockMovement[]
  executions     ProcedureExecution[]
}

/// Roles: OWNER owns the clinic account; MEMBER has full access; ASSISTANT is
/// the dental assistant profile — performs procedures and restocks, but does
/// not change the catalog nor see costs.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("MEMBER") // OWNER | MEMBER | ASSISTANT
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]

  stockMovements StockMovement[]
  executions     ProcedureExecution[]

  @@index([tenantId])
}

/// Persisted session: the cookie holds only an opaque random token, which
/// allows revoking access and exposes no data on the client.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Attempt counter per key ("login:user:<email>", "login:ip:<origin>",
/// "write:ip:<origin>"). It lives in the database because it must hold for
/// every application instance and survive restarts — in memory, a deploy would
/// clear the block.
model ThrottleCounter {
  key            String    @id
  failures       Int       @default(0)
  firstFailureAt DateTime
  blockedUntil   DateTime?
  updatedAt      DateTime  @updatedAt

  /// Used only by the cleanup of expired counters.
  @@index([updatedAt])
}

model Material {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  unit      String // ex: un, ml, g, par, tubete, rolete
  category  String?
  imageUrl  String?
  stock     Float    @default(0)
  minStock  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cost of ONE unit (the same as `unit`). Optional: a clinic that has not
  /// gathered prices yet keeps using the system, and cost reports simply state
  /// the partial coverage instead of showing a wrong number.
  unitCost  Float?
  /// Expiry of the current batch. Sterile supplies and anesthetics expire, and
  /// health inspections check it — the date lives on the material because a
  /// small clinic restocks one batch at a time.
  expiresAt DateTime?

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  procedureMaterials ProcedureMaterial[]
  stockMovements     StockMovement[]

  @@index([tenantId])
  @@index([name])
  @@index([supplierId])
  @@index([tenantId, expiresAt])
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([tenantId])
  @@index([name])
}

model Procedure {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  materials      ProcedureMaterial[]
  instruments    ProcedureInstrument[]
  stockMovements StockMovement[]
  executions     ProcedureExecution[]

  @@index([tenantId])
  @@index([name])
}

model ProcedureMaterial {
  id          String @id @default(cuid())
  procedureId String
  materialId  String
  quantity    Float

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  material  Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([procedureId, materialId])
}

/// An instrument is reusable and is not deducted when a procedure is
/// finalized, so it has no minimum stock: `stock` is the clinic's inventory.
model Instrument {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  category  String?
  imageUrl  String?
  stock     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  procedureInstruments ProcedureInstrument[]

  @@index([tenantId])
  @@index([name])
}

model ProcedureInstrument {
  id           String @id @default(cuid())
  procedureId  String
  instrumentId String
  quantity     Float

  procedure  Procedure  @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([procedureId, instrumentId])
}

/// Record of a finalized procedure — the basis of the clinic's history.
/// Names are stored as a snapshot on purpose: if a material is renamed or
/// deleted later, history stays faithful to what was actually used.
model ProcedureExecution {
  id            String   @id @default(cuid())
  tenantId      String
  procedureId   String?
  procedureName String
  category      String?
  createdAt     DateTime @default(now())

  /// Who finalized it. Optional because history older than this field has no
  /// author — inventing one would be worse than admitting the gap.
  userId   String?
  userName String?

  /// Groups procedures finalized together in one appointment. Two procedures
  /// in the same appointment produce two records (cost and consumption belong
  /// to each), linked by this identifier.
  sessionId String?

  /// Reversal. The execution is NOT deleted: it leaves the balance and stays
  /// in history, flagged — an audit trail cannot lose what happened, only
  /// record that it was undone.
  reversedAt     DateTime?
  reversedByName String?

  /// Total cost at finalization (sum of the items). A snapshot for the same
  /// reason as the names: changing a purchase price today must not rewrite
  /// what a procedure cost last month.
  totalCost Float?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  procedure Procedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  items          ProcedureExecutionItem[]
  stockMovements StockMovement[]

  @@index([tenantId, createdAt])
  @@index([sessionId])
}

model ProcedureExecutionItem {
  id          String  @id @default(cuid())
  executionId String
  kind        String // MATERIAL | INSTRUMENT
  name        String
  quantity    Float
  unit        String?

  /// Source material, while it still exists. It is what lets a reversal know
  /// where to return the quantity; null here only means "material deleted
  /// later", and the snapshotted name keeps history readable.
  materialId String?
  /// Unit cost in effect on that day.
  unitCost   Float?

  execution ProcedureExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

/// Every stock change goes through here — consumption, entry, adjustment and
/// reversal. It is the stock ledger: the balance in `Material.stock` is the
/// result, this model is the explanation.
model StockMovement {
  id          String   @id @default(cuid())
  tenantId    String
  materialId  String
  procedureId String?
  quantity    Float // negative = out, positive = in
  type        String // CONSUMPTION | RESTOCK | ADJUSTMENT | REVERSAL
  createdAt   DateTime @default(now())

  /// Author and justification. A manual adjustment without a reason is exactly
  /// the record that answers nothing when stock does not add up.
  userId   String?
  userName String?
  note     String?

  /// Unit cost of the ENTRY. This is where the material's cost comes from when
  /// the clinic restocks at a new price.
  unitCost Float?

  /// Execution that originated the movement (consumption and reversal).
  executionId String?

  material  Material            @relation(fields: [materialId], references: [id])
  procedure Procedure?          @relation(fields: [procedureId], references: [id])
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  execution ProcedureExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([materialId, createdAt])
}
