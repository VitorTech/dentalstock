# Banco (o docker-compose deste repositório sobe exatamente este Postgres)
DATABASE_URL="postgresql://dentalstock:dentalstock@localhost:5433/dentalstock?schema=public"

# Segredo de assinatura do JWT de sessão. Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"

# Opcional: dados do primeiro acesso criado por `npm run prisma:seed`
# SEED_TENANT_NAME="Clínica Exemplo"
# SEED_ADMIN_EMAIL="admin@clinica.com"
# SEED_ADMIN_PASSWORD="admin123"
