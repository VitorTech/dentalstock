# Database (the docker-compose in this repository starts exactly this Postgres)
DATABASE_URL="postgresql://dentalstock:dentalstock@localhost:5433/dentalstock?schema=public"

# Signing secret for the session JWT. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-secret-of-at-least-32-characters"

# Optional: credentials of the first user created by `npm run prisma:seed`
# SEED_TENANT_NAME="Example Clinic"
# SEED_ADMIN_EMAIL="admin@clinica.com"
# SEED_ADMIN_PASSWORD="admin123"
